(version 1)

# Main Control Unit - functional isolation design rules
# Generated against netlist v1.6.2 (236 nets, 7 net classes).
#
# RULE ORDER: KiCad applies the LAST matching rule - confirmed from a Clearance
# Report showing 'Rule applied; overrides previous constraints'. The narrow pad
# exemptions therefore come AFTER the wide barrier rules, at the end of the
# file. Do not move them to the top; they would be overridden.
#
# Basis: FUNCTIONAL isolation, not mains safety. Working voltage <= ~15V
# (house bank 14.6V), clamped transients <= ~30V. Electrical creepage need is
# under 0.5mm; 2.5mm is margin against salt-film surface tracking under
# conformal coating. The isolators do the safety work.

# ===== SECTION 1: island barriers - 2.5mm =====
(rule "Barrier LOGIC to SHIP"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'LOGIC_DOMAIN') && (B.NetClass == 'SHIP_DOMAIN')) || ((A.NetClass == 'SHIP_DOMAIN') && (B.NetClass == 'LOGIC_DOMAIN'))"))

(rule "Barrier LOGIC to M5"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'LOGIC_DOMAIN') && (B.NetClass == 'M5KW_KELLY_DOMAIN' || B.NetClass == 'M5KW_CAN_DOMAIN')) || ((A.NetClass == 'M5KW_KELLY_DOMAIN' || A.NetClass == 'M5KW_CAN_DOMAIN') && (B.NetClass == 'LOGIC_DOMAIN'))"))

(rule "Barrier LOGIC to M10"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'LOGIC_DOMAIN') && (B.NetClass == 'M10KW_KELLY_DOMAIN' || B.NetClass == 'M10KW_CAN_DOMAIN')) || ((A.NetClass == 'M10KW_KELLY_DOMAIN' || A.NetClass == 'M10KW_CAN_DOMAIN') && (B.NetClass == 'LOGIC_DOMAIN'))"))

(rule "Barrier LOGIC to SHIELD"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'LOGIC_DOMAIN') && (B.NetClass == 'SHIELD_DOMAIN')) || ((A.NetClass == 'SHIELD_DOMAIN') && (B.NetClass == 'LOGIC_DOMAIN'))"))

(rule "Barrier SHIP to M5"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'SHIP_DOMAIN') && (B.NetClass == 'M5KW_KELLY_DOMAIN' || B.NetClass == 'M5KW_CAN_DOMAIN')) || ((A.NetClass == 'M5KW_KELLY_DOMAIN' || A.NetClass == 'M5KW_CAN_DOMAIN') && (B.NetClass == 'SHIP_DOMAIN'))"))

(rule "Barrier SHIP to M10"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'SHIP_DOMAIN') && (B.NetClass == 'M10KW_KELLY_DOMAIN' || B.NetClass == 'M10KW_CAN_DOMAIN')) || ((A.NetClass == 'M10KW_KELLY_DOMAIN' || A.NetClass == 'M10KW_CAN_DOMAIN') && (B.NetClass == 'SHIP_DOMAIN'))"))

(rule "Barrier M5 to M10"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'M5KW_KELLY_DOMAIN' || A.NetClass == 'M5KW_CAN_DOMAIN') && (B.NetClass == 'M10KW_KELLY_DOMAIN' || B.NetClass == 'M10KW_CAN_DOMAIN')) || ((A.NetClass == 'M10KW_KELLY_DOMAIN' || A.NetClass == 'M10KW_CAN_DOMAIN') && (B.NetClass == 'M5KW_KELLY_DOMAIN' || B.NetClass == 'M5KW_CAN_DOMAIN'))"))

(rule "Barrier SHIELD to M5"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'SHIELD_DOMAIN') && (B.NetClass == 'M5KW_KELLY_DOMAIN' || B.NetClass == 'M5KW_CAN_DOMAIN')) || ((A.NetClass == 'M5KW_KELLY_DOMAIN' || A.NetClass == 'M5KW_CAN_DOMAIN') && (B.NetClass == 'SHIELD_DOMAIN'))"))

(rule "Barrier SHIELD to M10"
  (constraint clearance (min 2.5mm))
  (condition "((A.NetClass == 'SHIELD_DOMAIN') && (B.NetClass == 'M10KW_KELLY_DOMAIN' || B.NetClass == 'M10KW_CAN_DOMAIN')) || ((A.NetClass == 'M10KW_KELLY_DOMAIN' || A.NetClass == 'M10KW_CAN_DOMAIN') && (B.NetClass == 'SHIELD_DOMAIN'))"))

# ===== SECTION 2: intra-motor seam - 1.0mm =====
# Kelly and its own CAN island are bonded at NT1/NT2, so this is routing
# separation, not a galvanic barrier.
(rule "Seam M5KW Kelly to own CAN"
  (constraint clearance (min 1.0mm))
  (condition "((A.NetClass == 'M5KW_KELLY_DOMAIN') && (B.NetClass == 'M5KW_CAN_DOMAIN')) || ((A.NetClass == 'M5KW_CAN_DOMAIN') && (B.NetClass == 'M5KW_KELLY_DOMAIN'))"))

(rule "Seam M10KW Kelly to own CAN"
  (constraint clearance (min 1.0mm))
  (condition "((A.NetClass == 'M10KW_KELLY_DOMAIN') && (B.NetClass == 'M10KW_CAN_DOMAIN')) || ((A.NetClass == 'M10KW_CAN_DOMAIN') && (B.NetClass == 'M10KW_KELLY_DOMAIN'))"))

# ===== SECTION 3: SHIELD to SHIP - deliberately NOT a barrier =====
# Each shell is DC-floating, referenced to GND_SHIP only through its 1nF
# (C83-C86). All mounting holes H1-H9 are GND_SHIP, so the drain path runs to
# the board edge. A shield-to-chassis tracking fault is a benign end state.
(rule "Shield to ship ground - intentional reference"
  (constraint clearance (min 0.25mm))
  (condition "((A.NetClass == 'SHIELD_DOMAIN') && (B.NetClass == 'SHIP_DOMAIN')) || ((A.NetClass == 'SHIP_DOMAIN') && (B.NetClass == 'SHIELD_DOMAIN'))"))

# ===== SECTION 4: board edge and milled isolation slot =====
# Draw the 1.0-1.5mm isolation slot under ICT1 and IDCB1 on Edge.Cuts and this
# rule enforces copper standoff from it automatically.
(rule "Copper to board edge and cutouts"
  (constraint edge_clearance (min 0.5mm)))

# ===== SECTION 5: pad exemptions - MUST STAY LAST =====
# These parts EXIST to straddle a barrier; internal pad pitch is fixed by the
# package. Scoped to each part's own pads, so their pads against any foreign
# net still get the full barrier clearance from Section 1.
(rule "Barrier component internal pads"
  (constraint clearance (min 0.25mm))
  (condition "(A.memberOfFootprint('ICT1') && B.memberOfFootprint('ICT1')) || (A.memberOfFootprint('ICT2') && B.memberOfFootprint('ICT2')) || (A.memberOfFootprint('ICT3') && B.memberOfFootprint('ICT3')) || (A.memberOfFootprint('BII1') && B.memberOfFootprint('BII1')) || (A.memberOfFootprint('BII2') && B.memberOfFootprint('BII2')) || (A.memberOfFootprint('IDCB1') && B.memberOfFootprint('IDCB1')) || (A.memberOfFootprint('T1') && B.memberOfFootprint('T1')) || (A.memberOfFootprint('T2') && B.memberOfFootprint('T2')) || (A.memberOfFootprint('OI1') && B.memberOfFootprint('OI1')) || (A.memberOfFootprint('OI2') && B.memberOfFootprint('OI2')) || (A.memberOfFootprint('OI3') && B.memberOfFootprint('OI3')) || (A.memberOfFootprint('OI4') && B.memberOfFootprint('OI4')) || (A.memberOfFootprint('OI5') && B.memberOfFootprint('OI5')) || (A.memberOfFootprint('OI6') && B.memberOfFootprint('OI6')) || (A.memberOfFootprint('OI7') && B.memberOfFootprint('OI7')) || (A.memberOfFootprint('OI8') && B.memberOfFootprint('OI8')) || (A.memberOfFootprint('C4') && B.memberOfFootprint('C4'))"))

# Q3/Q6 are the alarm level-shift FETs the schematic says to keep near the
# netties; R104-R107 their series resistors; R110/R111 the DAC VREF feeds.
(rule "Intra-motor seam component internal pads"
  (constraint clearance (min 0.25mm))
  (condition "(A.memberOfFootprint('NT1') && B.memberOfFootprint('NT1')) || (A.memberOfFootprint('NT2') && B.memberOfFootprint('NT2')) || (A.memberOfFootprint('Q3') && B.memberOfFootprint('Q3')) || (A.memberOfFootprint('Q6') && B.memberOfFootprint('Q6')) || (A.memberOfFootprint('R104') && B.memberOfFootprint('R104')) || (A.memberOfFootprint('R105') && B.memberOfFootprint('R105')) || (A.memberOfFootprint('R106') && B.memberOfFootprint('R106')) || (A.memberOfFootprint('R107') && B.memberOfFootprint('R107')) || (A.memberOfFootprint('R110') && B.memberOfFootprint('R110')) || (A.memberOfFootprint('R111') && B.memberOfFootprint('R111'))"))
