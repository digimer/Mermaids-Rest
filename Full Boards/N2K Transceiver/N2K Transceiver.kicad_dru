(version 1)

(rule "iso_barrier_clearance"
  (constraint clearance (min 1.0mm))
  (condition "A.NetClass == 'ShipSide' && B.NetClass != 'ShipSide'"))

(rule "iso_barrier_hole"
  (constraint hole_clearance (min 1.0mm))
  (condition "A.NetClass == 'ShipSide' && B.NetClass != 'ShipSide'"))

(rule "iso_barrier_physical"
  (constraint physical_clearance (min 1.0mm))
  (condition "A.NetClass == 'ShipSide' && B.NetClass != 'ShipSide'"))