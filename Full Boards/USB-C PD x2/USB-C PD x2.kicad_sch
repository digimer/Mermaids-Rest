	(text "1. Optimize for 5V, 5A (Raspberry Pi)\n- Populate C_OUT_2, not C_OUT_1 or C_COUT_3\n - Co (Can) - 330 uF; Panasonic EEH-ZU1V331V\n - Rc (1206) - 20 KR; Stackpole RNCP1206FTD20K0\n - Cc (1206) - 10 nF; Kemet C1206C103J3RACAUTO\n - Cp (0805) - 220 pF; Kemet C0805C221J5GACAUTO\n2. General Purpose\n- Populate all three C_OUT_1/2/3\n - Co (Can) - 330 uF; Panasonic EEH-ZU1V331V\n - Rc (1206) - 2.2 KR; Stackpole RNCP1206FTD2K21\n - Cc (1206) - 470 nF; Kemet C1206C474J3RACAUTO\n - Cp (0805) - 1.5 nF; Kemet C0805C152J5GACAUTO\n"
		(exclude_from_sim no)
		(at 114.808 18.288 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1d320c1f-4cf5-413b-8c67-5f8a76858b8d")
	)
