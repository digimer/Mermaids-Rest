	)
	(text "-=] Type 2 Compensation Network (Config A and B)\n\nConfig A (5.1V/5A Optimized): \nf_p(plant) = 473 Hz, f_z(comp) = 795 Hz, f_p(comp) = 36.1 kHz\n\nConfig B (General Purpose 5V-20V): \nf_z(comp) = 154 Hz, f_p(comp) = 48.2 kHz\n\nGoverning Equations:\n1. Plant Pole:        f_p(plant) = 1 / (2π * R_load * C_out)\n2. Compensator Zero:  f_z(comp)  = 1 / (2π * R_c * C_c)\n3. Compensator Pole:  f_p(comp)  = 1 / (2π * R_c * C_p)"
		(exclude_from_sim no)
		(at 114.554 73.406 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "54b7355c-9922-46a7-98a0-cca0225c50bc")
	)
	(text "Status LEDs"
		(exclude_from_sim no)
		(at 248.92 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "57f46ada-6e37-47ce-a305-4422d69ce325")
	)
	(text "TVS are 24V, 0.5 pF to handle cable failure\nshorting 20V to the data lines, and keeping\ncapacitance on the data lines low."
