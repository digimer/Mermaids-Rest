	)
	(text "Configs:\nch0: A, ch1: A - R20 = 0R\nch0: A, ch1: B - R20 = 4.7KR\nch0: B, ch1: A - R20 = 10KR\nch0: B, ch1: B - R20 = DNP\n\nA: 5V, 5A rapid response, buck only (Raspberry Pi)\nB: Slower response, full range (General Purpose)\n\nSee compensation network notes"
		(exclude_from_sim no)
		(at 291.846 200.914 0)
		(effects
			(font
