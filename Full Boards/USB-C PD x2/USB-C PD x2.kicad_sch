	(text "-=] Max Input I = 20A, max temp 100°C\n\nLTC4368 Vgs = 10V\nID1 Rds(on) = 0.85 mΩ @ 25°C (~derate @ 100°C = 1.28 mΩ)\nHS1 Rds(on) = 1.45 mΩ @ 25°C (~derate @ 100°C = 2.10 mΩ)\n\nID1: \nPcold = (20)^2 * 0.00085  = 0.34W\nPhot  = (20)^2 * 0.001275 = 0.51W\n\nHS1:\nPcold = (20)^2 x 0.0014 = 0.54W\nPhot  = (20)^2 x 0.0021 = 0.84W\n\nPeak dissipation of 1.35W"
		(exclude_from_sim no)
		(at 16.256 89.408 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80c3bde4-9e78-4804-908b-f13d5d1e607a")
	)
