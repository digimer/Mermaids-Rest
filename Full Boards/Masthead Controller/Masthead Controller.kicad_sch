		)
		(uuid "0d414044-bdf9-4abe-99f6-7e87d2520bb5")
	)
	(text "MCU"
		(exclude_from_sim no)
		(at 17.018 150.368 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "14b9d166-0716-47f0-8f51-49af9c866c38")
	)
	(text "The eFuse is used for the N2K rather than a PTC for four reasons;\n1. Faster fault detection - The eFuse can detect and cut power in uS\n2. Off is actually off, where the PTC allows current leakage\n3. The software reset of the fuse doubles as a switched PDU\n4. Current monitoring can provide insight to potential pending failures\n\nThe 2N7002 is designed to protect the GPIO from 24v transients. Also,\nthe !SHDN can float to VIN, which would damage the GPIO. The gate\npulldown resistor ensures the fuse is deterministically set to on if the\nMCU fails to drive the shutdown signal."
		(exclude_from_sim no)
		(at 164.084 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1c6aa561-4677-4a34-8407-5e81924442d3")
	)
	(text "2-"
		(exclude_from_sim no)
		(at 337.566 125.984 0)
