	(text "1.4 uA current source\n0.3 ~ 2.5 VDC == range between 1% and 100% of ISENSE \n<0.3 VDC = off\n>2.5 VDC = 100%"
		(exclude_from_sim no)
		(at 354.076 175.514 0)
		(effects
