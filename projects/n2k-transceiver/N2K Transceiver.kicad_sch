	(text "Populate R3 _or_ R4, not both!\nR3: Forces PWM mode; consistent 2.2MHz switching. \n    Noisier, but consistently so. VHF squelch may be\n    quieter.\nR4: Auto mode; switches to PFM (bursts, 50 KHz) under\n    10~15% load (60~90mA). Expected that this board \n    will live in that boundary, possibly resulting in \n    frequent PWM <-> FPWM transitions. Bench testing \n    required.\nDecide and hard wire for final production."
		(exclude_from_sim no)
		(at 227.838 17.526 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c8f914b6-452c-488e-b946-1a45f02578ef")
	)
	(text "TB1 Pins:\n1. Shield (not used)\n2. V_RAW\n3. GND\n4. CAN High\n5. CAN Low\n"
		(exclude_from_sim no)
		(at 133.35 17.018 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d287bc7d-121c-47dd-a438-e1b678a5baa8")
	)
	(text "12v to 3.3v"
		(exclude_from_sim no)
		(at 164.592 14.986 0)
		(effects
