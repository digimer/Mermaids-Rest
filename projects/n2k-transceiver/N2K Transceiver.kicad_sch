	(text "Silver switches allowed, TI's TIC12400QDCPRQ1 is specifically\ndesigned to address silver oxide buildup. \n\nCables use:\n* Molex 0022013037 housing\n* Molex 0008550102 contact pins\n\nWire:\n* Alpha Wire AZ221934 family\n* TE Connectivity 55A0111-22 family\nIf Substituting - ETFE jacket, 22AWG, 19/34+ fine strand, tinned\n"
		(exclude_from_sim no)
		(at 140.97 191.516 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2b21871e-5d1d-4eda-862c-0d76e322863e")
	)
